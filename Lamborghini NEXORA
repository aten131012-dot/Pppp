local function dirs(y)
	return Vector3.new(-math.sin(y), 0, -math.cos(y)), Vector3.new(math.cos(y), 0, -math.sin(y))
end

local function makeRP(folder)
	local list = {}
	if folder then table.insert(list, folder) end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then table.insert(list, p.Character) end
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = list
	return rp
end

local function groundAt(p, folder)
	local r = workspace:Raycast(p + Vector3.new(0, 12, 0), Vector3.new(0, -300, 0), makeRP(folder))
	return r and r.Position.Y or nil
end

local hidden, hiddenDist = {}, nil
local function hideChar(c)
	hidden = {}
	for _, d in ipairs(c:GetDescendants()) do
		if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name ~= "HumanoidRootPart" then
			hidden[d] = d.Transparency
			d.Transparency = 1
		end
	end
	local hum = c:FindFirstChildOfClass("Humanoid")
	if hum then
		hiddenDist = hum.DisplayDistanceType
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end
local function showChar()
	for d, t in pairs(hidden) do
		pcall(function() d.Transparency = t end)
	end
	hidden = {}
	local c = lp.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if hum and hiddenDist then hum.DisplayDistanceType = hiddenDist end
	hiddenDist = nil
end

local function avg2(a, b)
	if a and b then return (a + b) / 2 end
	return a or b
end

