-- ===== ฟิสิกส์รถ + กล้อง (ทุกเฟรม) =====
local function step(dt)
	if not (folder and bodyModel and bodyModel.PrimaryPart) then return end
	dt = math.min(dt, 0.05)
	local drive = (state == "driving")
	local assist = opt.assist
	local thr, str, brakeOn, nitroWant = 0, 0, false, false
	if drive then
		thr = (down("fwd") and 1 or 0) - (down("back") and 1 or 0)
		str = (down("left") and 1 or 0) - (down("right") and 1 or 0)
		brakeOn = down("brake")
		nitroWant = down("nitro")
	end
	local rp = makeRP()

	-- ไนตรัส
	local nitroOn = false
	if nitroWant and not nitroLocked and thr >= 0 then
		nitroOn = true
		nitroAmt = math.max(nitroAmt - 30 * dt, 0)
		nitroCool = 1.2
		if nitroAmt <= 0 then nitroLocked = true end
		if thr <= 0 then thr = 1 end
	else
		nitroCool = nitroCool - dt
		if nitroCool <= 0 then nitroAmt = math.min(nitroAmt + 12 * dt, 100) end
		if nitroLocked and nitroAmt >= 25 then nitroLocked = false end
	end
	if nitroOn and not wasNitro then shake = math.max(shake, 0.35) fovKick = 10 end
	wasNitro = nitroOn

	-- เลี้ยว
	local fwdV, rightV = dirs(yaw)
	local vf = vel:Dot(fwdV)
	local maxSteer = 0.62 - (assist and 0.36 or 0.46) * math.clamp(math.abs(vf) / 120, 0, 1)
	steerAng = steerAng + (str * maxSteer - steerAng) * math.clamp(dt * (assist and 12 or 9), 0, 1)
	local yawRate = vf / 10.4 * math.tan(steerAng)
	if brakeOn and math.abs(vf) > 25 then yawRate = yawRate * 1.5 end
	yaw = yaw + math.clamp(yawRate, -2.8, 2.8) * dt

	fwdV, rightV = dirs(yaw)
	vf = vel:Dot(fwdV)
	local vl = vel:Dot(rightV)

	-- การเร่ง
	local maxF = MAX_SPEED * (nitroOn and 1.45 or 1)
	local ratio = math.clamp(vf / maxF, 0, 1.3)
	local pw = math.max(1 - ratio ^ 1.6, 0)
	local acc = (78 * pw + (ratio < 1 and 5 or 0)) * (nitroOn and 1.9 or 1)
	if thr > 0 then
		vf = vf + acc * dt
	elseif thr < 0 then
		if vf > 1 then vf = math.max(vf - 85 * dt, 0) else vf = math.max(vf - 38 * dt, -38) end
	else
		vf = vf - math.sign(vf) * math.min(math.abs(vf), 14 * dt)
	end
	if vf > MAX_SPEED and not nitroOn then vf = vf - 40 * dt end
	if brakeOn then vf = vf - math.sign(vf) * math.min(math.abs(vf), 95 * dt) end

	-- การเกาะถนน / ดริฟต์
	local grip = assist and 12 or 9
	if brakeOn then grip = (math.abs(vf) > 20 and math.abs(str) > 0) and 1.6 or 3 end
	if math.abs(vf) > 90 and math.abs(steerAng) > 0.2 then grip = math.min(grip, assist and 7 or 5) end
	vl = vl * (1 - math.clamp(grip * dt, 0, 1))
	vel = fwdV * vf + rightV * vl

	-- ชนสิ่งกีดขวาง
	local sp = Vector3.new(vel.X, 0, vel.Z)
	local spd = sp.Magnitude
	if spd > 2 then
		local dir = sp / spd
		local crash = false
		for _, off in ipairs({0, -2.8, 2.8}) do
			local origin = pos + rightV * off + Vector3.new(0, -0.3, 0)
			local hit = workspace:Raycast(origin, dir * (9.4 + spd * dt), rp)
			if hit and math.abs(hit.Normal.Y) < 0.6 then
				local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
				if n.Magnitude > 0 then
					n = n.Unit
					local vn = vel:Dot(n)
					if vn < 0 then vel = vel - n * vn * 1.4 end
					vel = vel * 0.8
					pos = pos + n * math.max(9.4 - hit.Distance, 0) * 0.6
					crash = true
				end
			end
		end
		if crash then
			shake = math.max(shake, math.min(spd / 80, 1))
			if sfx and spd > 15 and tick() - lastCrash > 0.4 then
				lastCrash = tick()
				sfx.shot("crash", math.clamp(spd / 70, 0.4, 1.3))
			end
		end
	end
	pos = pos + Vector3.new(vel.X, 0, vel.Z) * dt

	-- ความสูงพื้น 4 ล้อ
	fwdV, rightV = dirs(yaw)
	local function gh(p)
		local r = workspace:Raycast(Vector3.new(p.X, pos.Y + 5, p.Z), Vector3.new(0, -160, 0), rp)
		return r and r.Position.Y or nil
	end
	local gFL = gh(pos + fwdV * 5.2 - rightV * 2.9)
	local gFR = gh(pos + fwdV * 5.2 + rightV * 2.9)
	local gRL = gh(pos - fwdV * 5.2 - rightV * 2.9)
	local gRR = gh(pos - fwdV * 5.2 + rightV * 2.9)
	local gs = {gFL, gFR, gRL, gRR}
	local sum, cnt = 0, 0
	for i = 1, 4 do
		if gs[i] then sum = sum + gs[i]; cnt = cnt + 1 end
	end

	if cnt > 0 then
		local target = sum / cnt + CAR_H
		if air then
			vy = vy - 85 * dt
			local ny = pos.Y + vy * dt
			if ny <= target and vy <= 0 then
				ny = target
				if vy < -24 then
					shake = math.max(shake, 0.5)
					if sfx then sfx.shot("land", math.clamp(-vy / 50, 0.5, 1.2)) end
					vy = -vy * 0.3
				else
					vy = 0
					air = false
				end
			end
			pos = Vector3.new(pos.X, ny, pos.Z)
		else
			if pos.Y > target + 0.3 then
				air = true
			else
				local ny = pos.Y + (target - pos.Y) * math.clamp(dt * 18, 0, 1)
				vy = math.clamp((ny - pos.Y) / math.max(dt, 0.001), -50, 50)
				pos = Vector3.new(pos.X, ny, pos.Z)
				lastSafe = pos
			end
		end
	else
		air = true
		vy = vy - 85 * dt
		pos = pos + Vector3.new(0, vy * dt, 0)
	end
	if pos.Y < lastSafe.Y - 400 then
		pos = lastSafe + Vector3.new(0, 6, 0)
		vel, vy, air = Vector3.zero, 0, true
	end

	-- เอียงตัวถัง
	local pitchT, rollT = 0, 0
	if air or cnt == 0 then
		pitchT = math.clamp(vy / 80, -0.35, 0.35)
	else
		local gF, gR = avg2(gFL, gFR), avg2(gRL, gRR)
		local gLf, gRt = avg2(gFL, gRL), avg2(gFR, gRR)
		if gF and gR then pitchT = math.atan2(gF - gR, 10.4) end
		if gLf and gRt then rollT = math.atan2(gRt - gLf, 5.8) end
		pitchT = pitchT + math.clamp(((vf - lastVf) / math.max(dt, 0.001)) * 0.0007, -0.07, 0.07)
	end
	lastVf = vf
	rollT = rollT + math.clamp(-steerAng * vf * 0.0022, -0.09, 0.09)
	pitch = pitch + (pitchT - pitch) * math.clamp(dt * 10, 0, 1)
	roll = roll + (rollT - roll) * math.clamp(dt * 10, 0, 1)

	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.Angles(0, 0, roll)
	bodyModel:PivotTo(cf)

	-- ล้อ
	wheelAng = wheelAng + vf * dt / 1.2
	for _, w in ipairs(carInfo.wheels) do
		local sa = w.front and steerAng or 0
		local flip = (w.side < 0) and math.pi or 0
		local spin = (w.side < 0) and wheelAng or -wheelAng
		w.model:PivotTo(cf * N(w.x, 0, w.z) * A(0, sa, 0) * A(0, flip, 0) * A(spin, 0, 0))
	end

	-- ชิ้นส่วนขยับได้
	local wing = carInfo.movers.Wing
	if wing then
		local r = math.clamp(math.abs(vf) / MAX_SPEED, 0, 1.4)
		local t = 0.35 * math.clamp((r - 0.4) / 0.4, 0, 1)
		if opt.wingUp then t = 1 end
		if brakeOn and math.abs(vf) > 30 then t = 1 end
		wing.t = t
	end
	for name, m in pairs(carInfo.movers) do
		m.v = m.v + (m.t - m.v) * math.clamp(dt * ((name == "Wing") and 6 or 3.5), 0, 1)
		m.model:PivotTo(cf * m.fn(m.v))
	end

	-- ไฟเบรก / ไฟถอย / ไฟหน้า
	local braking = drive and (brakeOn or (thr < 0 and vf > 2))
	if carInfo.brakeLit ~= braking then
		carInfo.brakeLit = braking
		for _, t in ipairs(carInfo.tails) do
			t.Color = braking and Color3.fromRGB(255, 30, 30) or carInfo.tailBase
		end
		if carInfo.tailPL then carInfo.tailPL.Brightness = braking and 2 or 0 end
	end
	local rev = drive and thr < 0 and vf < -1
	if carInfo.revLit ~= rev then
		carInfo.revLit = rev
		for _, p in ipairs(carInfo.revs) do
			p.Material = rev and Enum.Material.Neon or Enum.Material.SmoothPlastic
			p.Color = rev and WHITE or Color3.fromRGB(60, 60, 64)
		end
	end
	if carInfo.beamOn ~= opt.lights then
		carInfo.beamOn = opt.lights
		for _, sl in ipairs(carInfo.heads) do sl.Enabled = opt.lights end
	end

	-- สีนีออน
	local nc = nitroOn and PURPLE or opt.neon
	if carInfo.neonCol ~= nc then
		carInfo.neonCol = nc
		for _, p in ipairs(carInfo.neon) do p.Color = nc end
	end

	-- ควันออกตัว / ดริฟต์
	local launching = drive and not air and thr > 0 and vf >= 0 and vf < 45 and not brakeOn
	local drifting = drive and not air and (math.abs(vl) > 9 or (brakeOn and math.abs(vf) > 28))
	for _, e in ipairs(carInfo.smokes) do e.Rate = (drifting and 45) or (launching and 28) or 0 end

	-- เสียง
	local ev
	if sfx then
		sfx.update({
			drive = drive, idle = true, speed = math.abs(vf), max = MAX_SPEED, thr = thr, nitro = nitroOn,
			slip = air and 0 or math.abs(vl), turn = math.abs(yawRate * vf),
			brake = brakeOn, air = air, dt = dt,
		})
		ev = sfx.ev
	end

	-- ท่อไอเสีย
	local fire = ev and (ev.shift or ev.pop)
	for _, x in ipairs(carInfo.exhs) do
		x.e.Rate = nitroOn and 120 or 0
		x.fl = math.max((x.fl or 0) - dt, 0)
		if fire then
			x.bf:Emit(ev.pop and 10 or 6)
			x.fl = 0.12
		end
		x.l.Color = nitroOn and PURPLE or Color3.fromRGB(255, 140, 40)
		x.l.Brightness = nitroOn and 3 or ((x.fl > 0) and 4 or 0)
	end
	if ev then
		if ev.shift then shake = math.max(shake, 0.1); fovKick = math.max(fovKick, 5) end
		ev.shift, ev.pop = false, false
	end

	if drive then
		local c = lp.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = cf * N(-0.95, 0.6, 0.3)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
		speedLbl.Text = math.floor(math.abs(vf) * 1.4) .. " km/h  •  G" .. (sfx and sfx.gear or 1)
		nitroFill.Size = UDim2.new(nitroAmt / 100, 0, 1, 0)
		nitroFill.BackgroundColor3 = nitroLocked and Color3.fromRGB(120, 70, 90) or PURPLE

		if tick() - lastDrag > 3 then
			camYaw = camYaw * (1 - math.clamp(dt * 1.5, 0, 1))
			camPitch = camPitch + (-0.2 - camPitch) * math.clamp(dt * 1.5, 0, 1)
		end
		local viewRot = CFrame.Angles(0, yaw + camYaw, 0) * CFrame.Angles(camPitch, 0, 0)
		local camPos = pos - viewRot.LookVector * camDist + Vector3.new(0, 2.2, 0)
		local want = CFrame.lookAt(camPos, pos + Vector3.new(0, 2.2, 0) + viewRot.LookVector * 5)
		shake = math.max(shake - dt * 3, 0)
		local sh = shake + (nitroOn and 0.12 or 0)
		if sh > 0 then
			want = want * N((math.random() - 0.5) * sh * 1.2, (math.random() - 0.5) * sh * 1.2, 0)
		end
		cam.CFrame = cam.CFrame:Lerp(want, math.clamp(dt * 10, 0, 1))
		fovKick = math.max(fovKick - dt * 20, 0)
		local wantFov = 70 + math.clamp(math.abs(vf) / MAX_SPEED, 0, 1.4) * 14 + (nitroOn and 10 or 0) + fovKick
		cam.FieldOfView = cam.FieldOfView + (wantFov - cam.FieldOfView) * math.clamp(dt * 4, 0, 1)
	end
end

