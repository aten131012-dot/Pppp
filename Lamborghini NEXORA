local function down(k) return inp[k] or keys[k] end

local function hold(btn, key)
	btn.InputBegan:Connect(function(i) if isPress(i) then inp[key] = true end end)
	btn.InputEnded:Connect(function(i) if isPress(i) then inp[key] = false end end)
end
