local function mk(parent, size, cf, color, o)
	o = o or {}
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = o.mat or Enum.Material.SmoothPlastic
	p.Transparency = o.tr or 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	if o.shape then p.Shape = o.shape end
	if o.refl then p.Reflectance = o.refl end
	p.CFrame = cf
	p.Parent = parent
	return p
end

-- ล้อ
local function buildWheel(w)
	local m = Instance.new("Model")
	m.Name = "Wheel"
	local tire = mk(m, V(w, 2.4, 2.4), N(0, 0, 0), Color3.fromRGB(12, 12, 14), {shape = CYL})
	m.PrimaryPart = tire
	local f = w / 2
	mk(m, V(0.12, 1.8, 1.8), N(f + 0.02, 0, 0), DGREY, {shape = CYL, mat = METAL})
	mk(m, V(0.06, 2.1, 2.1), N(f + 0.03, 0, 0), NEONC, {shape = CYL, mat = NEON})
	mk(m, V(0.08, 1.7, 1.7), N(f + 0.07, 0, 0), CARBON, {shape = CYL})
	for k = 0, 4 do
		mk(m, V(0.1, 1.8, 0.22), N(f + 0.14, 0, 0) * A(k * rad(36), 0, 0), LGREY, {mat = METAL})
	end
	for k = 0, 4 do
		mk(m, V(0.09, 1.4, 0.1), N(f + 0.17, 0, 0) * A(k * rad(36) + rad(18), 0, 0), ACCENT, {mat = NEON})
	end
	mk(m, V(0.18, 0.5, 0.5), N(f + 0.2, 0, 0), ACCENT, {shape = CYL, mat = NEON})
	return m
end

local function addText(part, face, text, color, strokeColor)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 60
	sg.LightInfluence = 0
	sg.Parent = part
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = color
	t.Parent = sg
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.2, 0)
	pad.PaddingBottom = UDim.new(0.2, 0)
	pad.PaddingLeft = UDim.new(0.08, 0)
	pad.PaddingRight = UDim.new(0.08, 0)
	pad.Parent = t
	local st = Instance.new("UIStroke")
	st.Color = strokeColor
	st.Thickness = 1.5
	st.Parent = t
end

local function csk(t, r, g, b) return ColorSequenceKeypoint.new(t, Color3.fromRGB(r, g, b)) end
local function nsk(t, v) return NumberSequenceKeypoint.new(t, v) end

-- ===== สร้างรถ Veneno (หัวรถอยู่ทาง -Z) =====
local function buildCar()
	local folder = Instance.new("Folder")
	folder.Name = "NEXORA_Car"
	local body = Instance.new("Model")
	body.Name = "Body"
	body.Parent = folder
	local info = {
		folder = folder, body = body, wheels = {}, tails = {}, heads = {}, smokes = {}, exhs = {},
		neon = {}, drl = {}, revs = {}, movers = {}, brakeLit = false, revLit = false,
	}
	local TAILC = Color3.fromRGB(150, 0, 10)
	info.tailBase = TAILC

	local PAINT = {refl = 0.35}
	local NEONO = {mat = NEON}
	local GL = {mat = GLASSM, tr = 0.4, refl = 0.2}

	local function P(parent, size, pos, color, o, rot)
		return mk(parent, size, N(pos) * (rot or CFrame.new()), color, o)
	end
	local function B(size, pos, color, o, rot) return P(body, size, pos, color, o, rot) end
	local function NE(parent, size, pos, rot)
		local p = P(parent, size, pos, NEONC, NEONO, rot)
		table.insert(info.neon, p)
		return p
	end
	local function tail(size, pos, rot)
		local t = P(body, size, pos, TAILC, NEONO, rot)
		table.insert(info.tails, t)
		return t
	end
	local function drl(size, pos, rot)
		local t = P(body, size, pos, LIGHT, NEONO, rot)
		table.insert(info.drl, t)
		return t
	end
	local function group(name)
		local m = Instance.new("Model")
		m.Name = name
		m.Parent = folder
		local pp = mk(m, V(1, 1, 1), N(), CARBON, {tr = 1})
		m.PrimaryPart = pp
		local mv = {model = m, v = 0, t = 0, fn = function() return CFrame.new() end}
		info.movers[name] = mv
		return m, mv
	end

	local pivot = B(V(1, 1, 1), V(0, 0, 0), CARBON, {tr = 1})
	body.PrimaryPart = pivot

	-- ===== ใต้ท้อง + สปลิตเตอร์ + ดิฟฟิวเซอร์ 3 ชั้น =====
	B(V(6.0, 0.3, 16.4), V(0, -0.6, 0), CARBON)
	B(V(7.2, 0.12, 2.4), V(0, -0.7, -9.0), CARBON)
	NE(body, V(7.2, 0.05, 0.1), V(0, -0.7, -10.2))
	B(V(7.0, 0.04, 0.25), V(0, -0.62, -9.9), WHITEC)                        -- ขอบขาวสปลิตเตอร์
	local glow = NE(body, V(4.6, 0.05, 12), V(0, -0.76, 0))
	glow.Transparency = 0.25
	for i = 0, 2 do
		B(V(5.4 - i * 0.5, 0.08, 1.8), V(0, -0.5 + i * 0.22, 8.6), CARBON, nil, A(-0.25, 0, 0))
	end
	for _, x in ipairs({-1.8, -0.9, 0, 0.9, 1.8}) do
		B(V(0.08, 0.7, 1.8), V(x, -0.2, 8.6), DGREY)
	end

	-- ===== ตัวถังหลัก =====
	B(V(5.2, 1.1, 8.4), V(0, 0.0, -0.9), CARBON)
	B(V(5.0, 1.4, 6.4), V(0, 0.3, 5.4), CARBON)
	B(V(4.0, 0.2, 4.6), V(0, 0.2, -0.2), CARBON)
	B(V(5.0, 0.2, 1.0), V(0, 1.2, 8.2), BODY_COLOR, PAINT)
	B(V(5.4, 1.3, 0.4), V(0, 0.7, 8.7), CARBON)
	B(V(6.2, 0.7, 1.2), V(0, 0.0, 8.4), BODY_COLOR, PAINT)

	-- ===== จมูกหน้า + กริลล์ =====
	B(V(5.6, 0.7, 1.6), V(0, -0.1, -8.2), BODY_COLOR, PAINT)
	B(V(2.2, 0.35, 0.1), V(0, -0.2, -9.03), CARBON)
	NE(body, V(2.2, 0.04, 0.1), V(0, 0.0, -9.04))
	B(V(5.2, 0.5, 0.5), V(0, -0.2, -8.0), CARBON)
	B(V(0.7, 0.06, 0.5), V(3.2, -0.45, -8.4), CARBON)
	B(V(0.7, 0.06, 0.5), V(-3.2, -0.45, -8.4), CARBON)

	-- ===== ห้องโดยสาร =====
	B(V(3.7, 0.1, 2.51), V(0, 1.33, -2.1), GLASS, GL, A(-0.30, 0, 0))
	B(V(3.4, 0.14, 2.4), V(0, 1.75, 0.3), BODY_COLOR, PAINT)
	B(V(3.2, 0.1, 1.0), V(0, 1.65, 1.95), GLASS, GL, A(0.1, 0, 0))
	-- แถบขาว-แดงบนหลังคา
	B(V(0.45, 0.03, 2.4), V(0, 1.84, 0.3), WHITEC)
	B(V(0.12, 0.03, 2.4), V(-0.35, 1.84, 0.3), ACCENT)
	B(V(0.12, 0.03, 2.4), V(0.35, 1.84, 0.3), ACCENT)
	B(V(3.6, 0.5, 1.0), V(0, 0.75, -2.7), CARBON)
	NE(body, V(1.2, 0.03, 0.4), V(0, 1.02, -2.6))
	local SEAT = Color3.fromRGB(34, 34, 40)
	for _, s in ipairs({1, -1}) do
		B(V(1.2, 0.4, 1.4), V(0.95 * s, 0.0, 0.4), SEAT)
		B(V(1.2, 1.2, 0.3), V(0.95 * s, 0.75, 1.05), SEAT, nil, A(0.15, 0, 0))
		B(V(0.4, 0.3, 0.25), V(0.95 * s, 1.45, 1.1), SEAT)
		B(V(0.5, 0.9, 0.05), V(0.95 * s, 0.75, 0.88), ACCENT, nil, A(0.15, 0, 0))
	end
	B(V(0.1, 0.85, 0.85), V(-0.95, 1.0, -1.55), CARBON, {shape = CYL}, A(-0.6, 0, 0) * A(0, rad(90), 0))

	-- ===== เครื่อง V12 =====
	B(V(2.8, 0.7, 2.6), V(0, 0.7, 4.6), CARBON, {mat = METAL})
	for _, s in ipairs({1, -1}) do
		B(V(0.7, 0.2, 2.2), V(0.8 * s, 1.08, 4.6), ACCENT, {mat = METAL})
	end
	NE(body, V(0.1, 0.05, 2.4), V(0, 1.1, 4.6))

	-- ===== ครีบฉลามกลางหลัง =====
	B(V(0.2, 1.0, 7.2), V(0, 1.9, 5.2), BODY_COLOR, PAINT, A(-0.09, 0, 0))
	B(V(0.22, 0.1, 6.6), V(0, 2.2, 5.3), WHITEC, nil, A(-0.09, 0, 0))
	B(V(0.22, 0.05, 6.8), V(0, 2.42, 5.3), ACCENT, {mat = NEON}, A(-0.09, 0, 0))

	-- ===== ฝากระโปรงหน้า (เปิดได้) =====
	B(V(4.6, 0.4, 5.6), V(0, 0.15, -5.4), CARBON)
	do
		local m, mv = group("Hood")
		local hinge = N(0, 0.9, -2.8)
		mv.fn = function(v) return hinge * A(v * 0.65, 0, 0) * hinge:Inverse() end
		local hoodCF = N(0, 0.55, -5.4) * A(-0.14, 0, 0)
		mk(m, V(5.0, 0.25, 5.6), hoodCF, BODY_COLOR, {refl = 0.35})
		mk(m, V(0.5, 0.03, 5.4), hoodCF * N(0, 0.14, 0), WHITEC)             -- แถบขาวกลางฝากระโปรง
		for _, x in ipairs({-0.9, 0.9}) do
			local l = mk(m, V(0.1, 0.04, 5.2), hoodCF * N(x, 0.14, 0), NEONC, {mat = NEON})
			table.insert(info.neon, l)
		end
		for i = 0, 2 do
			mk(m, V(1.4, 0.03, 0.14), hoodCF * N(0, 0.15, 1.4 + i * 0.3), DGREY)
		end
	end

	-- ===== ฝาเครื่องยนต์ (เปิดได้) =====
	do
		local m, mv = group("Engine")
		local hinge = N(0, 1.55, 2.4)
		mv.fn = function(v) return hinge * A(-v * 0.75, 0, 0) * hinge:Inverse() end
		for _, s in ipairs({1, -1}) do
			mk(m, V(1.7, 0.1, 5.4), N(0.95 * s, 1.5, 5.2) * A(0.05, 0, 0), CARBON, {mat = METAL})
			for i = 0, 5 do
				mk(m, V(1.7, 0.06, 0.14), N(0.95 * s, 1.57, 3.0 + i * 0.8), BODY_COLOR, {refl = 0.35})
			end
		end
	end

	-- ===== ปีกหลัง =====
	for _, s in ipairs({1, -1}) do
		B(V(0.25, 1.3, 0.7), V(1.6 * s, 2.25, 7.8), CARBON)
	end
	do
		local m, mv = group("Wing")
		local hinge = N(0, 3.0, 8.1)
		mv.fn = function(v) return N(0, v * 0.25, 0) * hinge * A(-(0.05 + v * 0.55), 0, 0) * hinge:Inverse() end
		mk(m, V(6.6, 0.16, 2.0), N(0, 3.0, 8.1), CARBON, {mat = METAL})
		mk(m, V(6.6, 0.08, 1.0), N(0, 3.14, 8.5) * A(-0.15, 0, 0), BODY_COLOR, {refl = 0.35})
		local wl = mk(m, V(6.4, 0.04, 0.06), N(0, 3.1, 7.3), NEONC, {mat = NEON})
		table.insert(info.neon, wl)
		for _, s in ipairs({1, -1}) do
			mk(m, V(0.12, 1.0, 2.6), N(3.3 * s, 2.95, 8.1), BODY_COLOR, {refl = 0.35})
			mk(m, V(0.14, 0.1, 2.4), N(3.3 * s, 2.7, 8.1), WHITEC)             -- แถบขาวปลายปีก
			local el = mk(m, V(0.14, 0.05, 2.4), N(3.3 * s, 3.2, 8.1), NEONC, {mat = NEON})
			table.insert(info.neon, el)
		end
	end

	-- ===== ท้ายรถ =====
	local plate = B(V(1.5, 0.4, 0.06), V(0, -0.05, 9.03), Color3.fromRGB(240, 240, 240))
	addText(plate, Enum.NormalId.Back, "NEXORA", Color3.fromRGB(20, 20, 20), Color3.fromRGB(240, 240, 240))
	NE(body, V(4.4, 0.06, 0.08), V(0, 1.3, 8.93))
	tail(V(1.0, 0.07, 0.08), V(0, 0.95, 8.94))
	local tpl = Instance.new("PointLight")
	tpl.Color = Color3.fromRGB(255, 20, 20)
	tpl.Range = 14
	tpl.Brightness = 0
	tpl.Parent = B(V(0.5, 0.5, 0.5), V(0, 0.9, 9.4), CARBON, {tr = 1})
	info.tailPL = tpl

	-- ===== ท่อไอเสีย 3 ท่อ =====
	for _, e in ipairs({{-1.0, 0.4}, {1.0, 0.4}, {0, 0.95}}) do
		local x, y = e[1], e[2]
		B(V(0.9, 0.85, 0.85), V(x, y, 8.95), DGREY, {shape = CYL, mat = METAL}, A(0, rad(90), 0))
		B(V(0.1, 0.6, 0.6), V(x, y, 9.42), Color3.new(0.02, 0.02, 0.02), {shape = CYL}, A(0, rad(90), 0))
		local ex = B(V(0.5, 0.5, 0.5), V(x, y, 9.6), CARBON, {tr = 1})
		local f = Instance.new("ParticleEmitter")
		f.Texture = "rbxasset://textures/particles/fire_main.dds"
		f.Color = ColorSequence.new({csk(0, 235, 175, 255), csk(0.4, 175, 80, 255), csk(1, 90, 20, 170)})
		f.Size = NumberSequence.new({nsk(0, 1.8), nsk(1, 0.2)})
		f.Transparency = NumberSequence.new({nsk(0, 0.1), nsk(1, 1)})
		f.Lifetime = NumberRange.new(0.25, 0.4)
		f.Speed = NumberRange.new(28, 38)
		f.SpreadAngle = Vector2.new(3, 3)
		f.LightEmission = 1
		f.LightInfluence = 0
		f.LockedToPart = false
		f.EmissionDirection = Enum.NormalId.Back
		f.Rate = 0
		f.Parent = ex
		local bf = Instance.new("ParticleEmitter")
		bf.Texture = "rbxasset://textures/particles/fire_main.dds"
		bf.Color = ColorSequence.new({csk(0, 255, 230, 140), csk(0.5, 255, 120, 20), csk(1, 120, 20, 0)})
		bf.Size = NumberSequence.new({nsk(0, 1.4), nsk(1, 0.1)})
		bf.Transparency = NumberSequence.new({nsk(0, 0.05), nsk(1, 1)})
		bf.Lifetime = NumberRange.new(0.12, 0.22)
		bf.Speed = NumberRange.new(18, 30)
		bf.SpreadAngle = Vector2.new(8, 8)
		bf.LightEmission = 1
		bf.LightInfluence = 0
		bf.LockedToPart = false
		bf.EmissionDirection = Enum.NormalId.Back
		bf.Rate = 0
		bf.Parent = ex
		local l = Instance.new("PointLight")
		l.Color = PURPLE
		l.Range = 16
		l.Brightness = 0
		l.Parent = ex
		table.insert(info.exhs, {e = f, bf = bf, l = l, fl = 0})
	end

	-- ===== ชิ้นส่วนซ้าย/ขวา =====
	for _, s in ipairs({1, -1}) do
		B(V(0.55, 0.5, 7.8), V(3.0 * s, -0.35, -0.3), CARBON)
		NE(body, V(0.08, 0.07, 7.4), V(3.3 * s, -0.5, -0.3))
		B(V(0.1, 0.06, 7.4), V(3.29 * s, -0.3, -0.3), WHITEC)                -- แถบขาวซิลข้าง
		B(V(1.0, 0.18, 7.0), V(2.45 * s, 1.15, 0), BODY_COLOR, PAINT)
		B(V(0.4, 0.95, 2.0), V(2.95 * s, 0.55, 2.8), CARBON)
		B(V(0.44, 0.06, 1.8), V(2.95 * s, 0.3, 2.8), DGREY)
		NE(body, V(0.44, 0.06, 1.8), V(2.95 * s, 0.55, 2.8))
		B(V(0.44, 0.06, 1.8), V(2.95 * s, 0.8, 2.8), DGREY)

		B(V(1.9, 0.3, 3.6), V(2.7 * s, 1.45, -5.2), BODY_COLOR, PAINT)
		B(V(0.3, 1.5, 3.6), V(2.1 * s, 0.5, -5.2), CARBON)
		B(V(0.2, 0.25, 3.6), V(3.65 * s, 1.35, -5.2), BODY_COLOR, PAINT)
		NE(body, V(0.06, 0.06, 3.5), V(3.77 * s, 1.35, -5.2))
		B(V(1.0, 0.04, 1.4), V(2.9 * s, 1.62, -5.2), CARBON)
		NE(body, V(1.0, 0.03, 0.08), V(2.9 * s, 1.65, -5.2))
		B(V(1.3, 0.8, 2.0), V(2.5 * s, 0.35, -7.8), BODY_COLOR, PAINT)

		B(V(1.4, 0.3, 0.1), V(2.0 * s, -0.25, -9.03), CARBON)
		NE(body, V(1.4, 0.04, 0.12), V(2.0 * s, -0.07, -9.04))

		local hs = B(V(2.2, 0.22, 0.3), V(2.0 * s, 0.1, -8.95), CARBON)
		drl(V(0.9, 0.08, 0.08), V(1.0 * s, 0.07, -9.12))
		drl(V(1.2, 0.08, 0.08), V(2.1 * s, 0.19, -9.12), A(0, 0, 0.28 * s))
		drl(V(1.2, 0.08, 0.08), V(2.1 * s, -0.05, -9.12), A(0, 0, -0.28 * s))
		drl(V(0.5, 0.16, 0.08), V(2.85 * s, 0.07, -9.12))
		local sl = Instance.new("SpotLight")
		sl.Face = Enum.NormalId.Front
		sl.Angle = 70
		sl.Range = 110
		sl.Brightness = 4
		sl.Color = Color3.fromRGB(235, 245, 255)
		sl.Enabled = false
		sl.Parent = hs
		table.insert(info.heads, sl)

		B(V(2.0, 0.35, 3.8), V(2.9 * s, 1.5, 5.4), BODY_COLOR, PAINT)
		B(V(0.2, 0.3, 3.8), V(3.85 * s, 1.45, 5.4), BODY_COLOR, PAINT)
		NE(body, V(0.06, 0.06, 3.7), V(3.97 * s, 1.45, 5.4))
		B(V(0.9, 1.3, 1.6), V(2.7 * s, 0.45, 7.7), BODY_COLOR, PAINT)

		tail(V(1.6, 0.07, 0.08), V(1.2 * s, 0.95, 8.94))
		tail(V(1.2, 0.07, 0.08), V(2.3 * s, 1.15, 8.94), A(0, 0, 0.35 * s))
		tail(V(1.2, 0.07, 0.08), V(2.3 * s, 0.75, 8.94), A(0, 0, -0.35 * s))
		local rv = B(V(0.8, 0.1, 0.06), V(2.4 * s, 0.1, 9.04), Color3.fromRGB(60, 60, 64))
		table.insert(info.revs, rv)

		local sp = B(V(0.5, 0.5, 0.5), V(2.95 * s, -1.0, 5.2), CARBON, {tr = 1})
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/smoke_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(235, 235, 240))
		e.Size = NumberSequence.new({nsk(0, 2.5), nsk(1, 7)})
		e.Transparency = NumberSequence.new({nsk(0, 0.45), nsk(1, 1)})
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(3, 7)
		e.SpreadAngle = Vector2.new(35, 35)
		e.EmissionDirection = Enum.NormalId.Top
		e.LockedToPart = false
		e.Rate = 0
		e.Parent = sp
		table.insert(info.smokes, e)

		-- ประตูกรรไกร
		do
			local m, mv = group(s > 0 and "DoorR" or "DoorL")
			local hinge = N(2.9 * s, 1.15, -3.2)
			mv.fn = function(v) return hinge * A(-v * 0.95, 0, v * 0.38 * s) * hinge:Inverse() end
			local door = mk(m, V(0.35, 1.1, 4.8), N(2.95 * s, 0.55, -0.8), BODY_COLOR, {refl = 0.35})
			addText(door, (s > 0) and Enum.NormalId.Right or Enum.NormalId.Left, "NEXORA", TEXT_COLOR, Color3.fromRGB(30, 0, 0))
			mk(m, V(0.38, 0.1, 4.4), N(2.95 * s, 0.15, -0.8), WHITEC)           -- แถบขาวประตู
			NE(m, V(0.4, 0.05, 4.8), V(2.95 * s, 0.05, -0.8))
			NE(m, V(0.4, 0.05, 4.8), V(2.95 * s, 1.0, -0.8))
			mk(m, V(0.1, 0.85, 3.4), N(2.1 * s, 1.55, -0.1) * A(0, 0, 0.4 * s), GLASS, GL)
			mk(m, V(0.5, 0.3, 0.55), N(2.75 * s, 1.5, -3.0), BODY_COLOR, {refl = 0.35})
			NE(m, V(0.52, 0.05, 0.5), V(2.75 * s, 1.36, -3.0))
		end
	end

	-- ===== ล้อ =====
	local function wheelAt(name, x, z, w, side, front)
		local wm = buildWheel(w)
		wm.Name = name
		wm.Parent = folder
		table.insert(info.wheels, {model = wm, x = x, z = z, side = side, front = front})
	end
	wheelAt("FL", -2.85, -5.2, 1.2, -1, true)
	wheelAt("FR", 2.85, -5.2, 1.2, 1, true)
	wheelAt("RL", -2.95, 5.2, 1.5, -1, false)
	wheelAt("RR", 2.95, 5.2, 1.5, 1, false)

	folder.Parent = workspace
	return info
end

