local function cleanup()
	if carConn then carConn:Disconnect() carConn = nil end
	if sfx then sfx.destroy() sfx = nil end
	if folder then folder:Destroy() folder = nil end
	carInfo, bodyModel = nil, nil
	for k in pairs(inp) do inp[k] = false end
	for k in pairs(keys) do keys[k] = false end
	showChar()
	local c = lp.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if hrp then hrp.Anchored = false end
	if hum then
		hum.PlatformStand = false
		cam.CameraSubject = hum
	end
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = oldFOV
	setState("idle")
end

local function spawnCar()
	local c = lp.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if state == "driving" then return end
	if carConn then carConn:Disconnect() carConn = nil end
	if sfx then sfx.destroy() sfx = nil end
	if folder then folder:Destroy() folder = nil end

	carInfo = buildCar()
	folder = carInfo.folder
	bodyModel = carInfo.body

	local f = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
	f = (f.Magnitude > 0) and f.Unit or Vector3.new(0, 0, -1)
	local R = Vector3.new(-f.Z, 0, f.X)
	local p = hrp.Position + f * 22
	local gy = groundAt(p) or (hrp.Position.Y - 3)
	pos = Vector3.new(p.X, gy + CAR_H + 28, p.Z)
	lastSafe = pos
	yaw = math.atan2(-R.X, -R.Z)
	vel, vy, air = Vector3.zero, 0, true
	pitch, roll, steerAng, wheelAng, lastVf = 0, 0, 0, 0, 0
	nitroAmt, nitroLocked, nitroCool, shake, wasNitro, fovKick = 100, false, 0, 0, false, 0
	setState("spawned")

	sfx = SFX.attach(bodyModel.PrimaryPart)
	sfx.shot("call")
	sfx.shot("whoosh")
	carConn = RS.RenderStepped:Connect(step)
end

local function boardCar()
	if state ~= "spawned" or not carInfo then return end
	local c = lp.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum) then return end
	hideChar(c)
	hum.PlatformStand = true
	hrp.Anchored = true
	cam.CameraType = Enum.CameraType.Scriptable
	camYaw, camPitch, camDist = 0, -0.2, 30
	setState("driving")
	if sfx then
		sfx.shot("door")
		sfx.shot("hyd")
		sfx.shot("start")
		sfx.blip()
	end
	setDoors(1)
	task.delay(0.9, function()
		if state == "driving" then
			setDoors(0)
			if sfx then sfx.shot("door") end
		end
	end)
end

local function exitCar()
	if state ~= "driving" then return end
	local c = lp.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local _, rightV = dirs(yaw)
	setState("spawned")
	showChar()
	for k in pairs(inp) do inp[k] = false end
	for k in pairs(keys) do keys[k] = false end
	if hrp then
		hrp.Anchored = false
		hrp.CFrame = CFrame.new(pos - rightV * 7 + Vector3.new(0, 3, 0))
	end
	if hum then
		hum.PlatformStand = false
		cam.CameraSubject = hum
	end
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = oldFOV
	if sfx then sfx.shot("door") sfx.shot("hyd") end
	setDoors(1)
	task.delay(3, function()
		if carInfo and state == "spawned" then setDoors(0) end
	end)
end

bind(callBtn.MouseButton1Click, spawnCar)
bind(boardBtn.MouseButton1Click, boardCar)
bind(exitBtn.MouseButton1Click, exitCar)
bind(lp.CharacterAdded, cleanup)

C.actions.call = spawnCar
C.actions.toggle = function()
	if state == "spawned" then boardCar() elseif state == "driving" then exitCar() end
end

