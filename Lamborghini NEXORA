C.onState = function(st)
	if st ~= "spawned" then return end
	local car = api.car()
	if not car then return end
	task.spawn(function()
		for _ = 1, 3 do
			for _, p in ipairs(car.drl) do pcall(function() p.Transparency = 0.9 end) end
			for _, p in ipairs(car.tails) do pcall(function() p.Transparency = 0.9 end) end
			task.wait(0.12)
			for _, p in ipairs(car.drl) do pcall(function() p.Transparency = 0 end) end
			for _, p in ipairs(car.tails) do pcall(function() p.Transparency = 0 end) end
			task.wait(0.12)
		end
	end)
