-- ใส่เอฟเฟกต์ให้ Sound (ถ้าเวอร์ชันไหนไม่รองรับจะข้ามเอง)
local function fx(s, kind, props)
	local out
	pcall(function()
		local x = Instance.new(kind)
		for k, v in pairs(props) do x[k] = v end
		x.Parent = s
		out = x
	end)
	return out
end

local SFX = {}

function SFX.attach(part)
	local h = {gear = 1, rpm = 0.1, rev = 0, pthr = 0, nprev = false,
		revHold = false, limT = 0, limHi = true, alive = true}
	h.ev = {shift = false, pop = false}
	local loops = {}

	local function loop(name, extra)
		local s = Instance.new("Sound")
		s.Name = name
		s.SoundId = resolve(IDS[name])
		s.Looped = true
		s.Volume = 0
		s.RollOffMinDistance = 60
		s.RollOffMaxDistance = 400
		s.Parent = part
		if extra then extra(s) end
		pcall(function() s:Play() end)
		loops[name] = s
		return s
	end
	loop("engine", function(s)
		fx(s, "DistortionSoundEffect", {Level = 0.55})
		fx(s, "EqualizerSoundEffect", {LowGain = 5, MidGain = -3, HighGain = 2})
		fx(s, "ChorusSoundEffect", {Depth = 0.4, Mix = 0.45, Rate = 4})
		h.trem = fx(s, "TremoloSoundEffect", {Frequency = 8, Depth = 0.5})
		fx(s, "ReverbSoundEffect", {DecayTime = 1.2, Density = 0.6, Diffusion = 0.8, DryLevel = 0, WetLevel = -9})
	end)
	loop("engine2", function(s)
		fx(s, "DistortionSoundEffect", {Level = 0.85})
		fx(s, "EqualizerSoundEffect", {LowGain = -6, MidGain = 4, HighGain = 5})
	end)
	loop("engine3", function(s)
		fx(s, "DistortionSoundEffect", {Level = 0.95})
		fx(s, "EqualizerSoundEffect", {LowGain = -10, MidGain = 0, HighGain = 8})
	end)
	loop("scream", function(s)
		fx(s, "EqualizerSoundEffect", {LowGain = -10, MidGain = 2, HighGain = 6})
	end)
	loop("turbo", function(s)
		fx(s, "EqualizerSoundEffect", {LowGain = -12, MidGain = -2, HighGain = 8})
	end)
	loop("wind") loop("skid") loop("nitro")

	function h.shot(name, volMul, pitchMul)
		local d = SHOTDEF[name] or {1, 1, 5}
		local s = Instance.new("Sound")
		s.SoundId = resolve(IDS[name] or BASS)
		s.Volume = d[1] * (volMul or 1)
		s.PlaybackSpeed = d[2] * (pitchMul or 1)
		s.RollOffMinDistance = 60
		s.RollOffMaxDistance = 400
		s.Parent = part
		if name == "pop" or name == "crash" or name == "start" then
			fx(s, "DistortionSoundEffect", {Level = 0.75})
		end
		pcall(function() s:Play() end)
		Debris:AddItem(s, d[3] or 5)
	end

	function h.blip() h.rev = 1 end

	-- ปุ่มเบิ้ล: กดค้าง = เร่งเครื่องชนลิมิตเตอร์ มีเสียงระเบิด + เปลวไฟ
	function h.horn(on)
		h.revHold = on
		if on then
			h.shot("start", 1.0, 1.3)
			h.ev.pop = true
			h.limT, h.limHi = 0, true
		end
	end

	local function ease(s, vol, pitch, a)
		s.Volume = s.Volume + (vol - s.Volume) * a
		if pitch then s.PlaybackSpeed = s.PlaybackSpeed + (pitch - s.PlaybackSpeed) * a end
	end

	-- d = {drive, idle, speed, max, thr, nitro, slip, turn, brake, air, dt}
	function h.update(d)
		local dt = d.dt
		local a = math.clamp(dt * 8, 0, 1)
		local r = math.clamp(d.speed / d.max, 0, 1.6)

		-- เกียร์ 7 สปีด (เกียร์ต้นยาว เกียร์ปลายสั้น)
		local gearPos = 7 * (math.clamp(r / 1.05, 0, 1.6)) ^ 1.3
		local g = math.min(math.floor(gearPos) + 1, 7)
		local within = (g < 7) and (gearPos % 1) or math.clamp(gearPos - 6, 0, 1)
		if g ~= h.gear then
			if d.drive and g > h.gear and d.thr > 0 then
				h.shot("shift")
				h.shot("pop", 0.7, 1.8)
				h.ev.shift = true
				h.rpm = h.rpm * 0.62
			elseif d.drive and g < h.gear and d.speed > 40 and d.thr <= 0 then
				h.shot("pop", 0.6, 1.6)             -- ลดเกียร์: เบิ้ลเครื่อง
				h.ev.pop = true
				h.rev = math.max(h.rev, 0.65)
			end
			h.gear = g
		end

		-- รอบเครื่อง
		local rpmT
		if d.drive then
			rpmT = (d.thr > 0) and (0.2 + 0.78 * within) or (0.14 + 0.4 * within)
			if d.thr > 0 and d.speed < 10 then rpmT = 0.85 end
		else
			rpmT = 0.12
		end
		if h.revHold then                                   -- ลิมิตเตอร์เด้งไปมา
			h.limT = h.limT + dt
			if h.limT > 0.085 then
				h.limT = 0
				h.limHi = not h.limHi
				if not h.limHi then
					h.shot("pop", 0.7, 1.4 + math.random() * 0.5)
					h.ev.pop = true
				end
			end
			rpmT = h.limHi and 1.0 or 0.78
		end
		rpmT = math.max(rpmT, h.rev)
		h.rev = math.max(h.rev - dt * 1.4, 0)
		local rate = h.revHold and 18 or ((rpmT > h.rpm) and 9 or 5)
		h.rpm = h.rpm + (rpmT - h.rpm) * math.clamp(dt * rate, 0, 1)

		-- ปล่อยคันเร่งตอนเร็ว: blow-off + ไอเสียแตกเป็นชุด
		if d.drive and h.pthr > 0 and d.thr <= 0 and d.speed > 45 and h.rpm > 0.45 then
			h.shot("blow", 0.7, 1.3)
			h.ev.pop = true
			for _ = 1, 6 do
				task.delay(0.05 + math.random() * 0.9, function()
					if h.alive then
						h.shot("pop", 0.5 + math.random() * 0.5, 1.0 + math.random() * 1.2)
						h.ev.pop = true
					end
				end)
			end
		end
		h.pthr = d.thr

		if d.nitro and not h.nprev then h.shot("blow", 1.0, 0.7) end
		h.nprev = d.nitro

		local running = d.drive or d.idle or h.revHold
		local mul = (d.drive or h.revHold) and 1 or 0.3
		local load = (d.thr ~= 0 or h.revHold) and 1 or 0.35
		local rp = h.rpm
		if running then
			ease(loops.engine, (0.3 + 0.35 * load + 0.25 * rp) * mul, 0.4 + rp * 1.0 + (d.nitro and 0.15 or 0), a)
			ease(loops.engine2, (rp * 0.45 * load) * mul, 0.8 + rp * 1.3, a)
			ease(loops.engine3, (math.max(rp - 0.4, 0) * 0.6 * load) * mul, 1.6 + rp * 1.8, a)
			local scr = (d.drive or h.revHold) and (math.clamp((rp - 0.55) * 1.2, 0, 0.5) * (((d.thr > 0) or h.revHold) and 1 or 0.4)) or 0
			ease(loops.scream, scr, 1.6 + rp * 1.3, a)
			local tb = (d.drive and d.thr > 0) and math.clamp((rp - 0.3) * 0.5, 0, 0.3) or 0
			ease(loops.turbo, tb, 2.2 + rp * 1.2, a)
		else
			ease(loops.engine, 0, nil, a)
			ease(loops.engine2, 0, nil, a)
			ease(loops.engine3, 0, nil, a)
			ease(loops.scream, 0, nil, a)
			ease(loops.turbo, 0, nil, a)
		end

		-- จังหวะสั่นของเครื่องตามรอบ
		if h.trem then
			pcall(function() h.trem.Frequency = math.clamp(6 + rp * 14, 1, 20) end)
		end

		ease(loops.wind, d.drive and math.clamp(r, 0, 1) * 0.45 or 0, 0.7 + r * 0.5, a)

		-- ดริฟต์ / เบรกแรง / เลี้ยวเร็ว
		local slip = math.clamp(d.slip / 18, 0, 1)
		local brk = (d.brake and d.speed > 25) and 0.8 or 0
		local turnVol = math.clamp((d.turn - 40) / 120, 0, 0.5)
		local skidVol = (d.drive and not d.air) and math.max(slip * 0.9, brk, turnVol) or 0
		ease(loops.skid, skidVol, 1.5 + slip * 0.4, a)

		ease(loops.nitro, (d.drive and d.nitro) and 0.9 or 0, 0.75, a)
	end

	function h.destroy()
		h.alive = false
		h.revHold = false
		for _, s in pairs(loops) do pcall(function() s:Destroy() end) end
		loops = {}
	end

	return h
end

