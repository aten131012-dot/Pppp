	table.insert(C.conns5, c)
	return c
end

local opt, fbtn, setBtnText, api = C.opt, C.fbtn, C.setBtnText, C.api

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function toggleMovers(names)
	local car = api.car()
	if not car then return end
	local first = car.movers[names[1]]
	if not first then return end
	local target = (first.t > 0.5) and 0 or 1
	for _, n in ipairs(names) do
		local m = car.movers[n]
		if m then m.t = target end
	end
	local s = api.sfx()
	if s then
		s.shot("hyd")
		task.delay(0.35, function() local s2 = api.sfx() if s2 then s2.shot("door") end end)
	end
end

local actions = {}
actions.door   = function() toggleMovers({"DoorL", "DoorR"}) end
actions.hood   = function() toggleMovers({"Hood"}) end
actions.engine = function() toggleMovers({"Engine"}) end

actions.wing = function()
	opt.wingUp = not opt.wingUp
	local s = api.sfx()
	if s then s.shot("hyd") end
	setBtnText(fbtn.wing, opt.wingUp and "ปีก: ยก" or "ปีกหลัง")
end

actions.lights = function()
	opt.lights = not opt.lights
	local s = api.sfx()
	if s then s.shot("door", 0.6, 1.4) end
	setBtnText(fbtn.lights, opt.lights and "ไฟ: เปิด" or "ไฟ: ปิด")
end

local NEONS = {
	Color3.fromRGB(255, 30, 50),
	Color3.fromRGB(0, 200, 255),
	Color3.fromRGB(175, 80, 255),
	Color3.fromRGB(60, 255, 120),
	Color3.fromRGB(240, 240, 255),
	Color3.fromRGB(255, 190, 40),
}
local neonIdx = 1
actions.neon = function()
	neonIdx = neonIdx % #NEONS + 1
	opt.neon = NEONS[neonIdx]
	local s = api.sfx()
	if s then s.shot("door", 0.5, 1.8) end
end

actions.assist = function()
	opt.assist = not opt.assist
	setBtnText(fbtn.assist, opt.assist and "ช่วยขับ: เปิด" or "ช่วยขับ: ปิด")
end

for id, fn in pairs(actions) do
	if fbtn[id] then bind(fbtn[id].MouseButton1Click, fn) end
end
local function horn(on)
	local s = api.sfx()
	if s then s.horn(on) end
end
bind(fbtn.horn.InputBegan, function(i) if isPress(i) then horn(true) end end)
bind(fbtn.horn.InputEnded, function(i) if isPress(i) then horn(false) end end)

local keyAct = {
	[Enum.KeyCode.Z] = "door", [Enum.KeyCode.X] = "hood", [Enum.KeyCode.C] = "engine",
	[Enum.KeyCode.V] = "wing", [Enum.KeyCode.L] = "lights", [Enum.KeyCode.N] = "neon",
	[Enum.KeyCode.T] = "assist",
}
bind(UIS.InputBegan, function(i, gp)
	if gp then return end
	if api.state() == "idle" then return end
	if i.KeyCode == Enum.KeyCode.H then horn(true) return end
	local a = keyAct[i.KeyCode]
	if a then actions[a]() end
end)
bind(UIS.InputEnded, function(i)
	if i.KeyCode == Enum.KeyCode.H then horn(false) end
end)

