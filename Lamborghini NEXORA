-- ===== สถานะ =====
local state = "idle"
local carInfo, folder, bodyModel, carConn, sfx
local pos, yaw, vel = Vector3.zero, 0, Vector3.zero
local vy, air = 0, false
local pitch, roll, steerAng, wheelAng = 0, 0, 0, 0
local nitroAmt, nitroLocked, nitroCool, wasNitro = 100, false, 0, false
local shake, lastVf, lastSafe, lastCrash, fovKick = 0, 0, Vector3.zero, 0, 0
local camYaw, camPitch, camDist, lastDrag = 0, -0.2, 30, 0
local oldFOV = cam.FieldOfView

