local V, A, N, rad = Vector3.new, CFrame.Angles, CFrame.new, math.rad
local CYL = Enum.PartType.Cylinder
local CARBON = Color3.fromRGB(24, 24, 28)
local DGREY = Color3.fromRGB(58, 60, 68)
local LGREY = Color3.fromRGB(165, 170, 180)
