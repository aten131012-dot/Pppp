-- {ความดัง, ความเร็วเสียง, อายุเสียง(วินาที)}
local SHOTDEF = {
	crash = {1.0, 0.5, 5}, land = {0.8, 0.6, 5}, door = {0.9, 1, 3}, call = {0.6, 1, 3},
	shift = {0.5, 1.5, 3}, whoosh = {0.8, 1.1, 5}, hyd = {0.5, 0.55, 3},
