local keyMap = {
	[Enum.KeyCode.W] = "fwd", [Enum.KeyCode.Up] = "fwd",
	[Enum.KeyCode.S] = "back", [Enum.KeyCode.Down] = "back",
	[Enum.KeyCode.A] = "left", [Enum.KeyCode.Left] = "left",
	[Enum.KeyCode.D] = "right", [Enum.KeyCode.Right] = "right",
	[Enum.KeyCode.LeftShift] = "nitro", [Enum.KeyCode.RightShift] = "nitro",
	[Enum.KeyCode.Space] = "brake",
}
local actKey = {[Enum.KeyCode.R] = "call", [Enum.KeyCode.F] = "toggle"}

bind(UIS.InputBegan, function(i, gp)
	if gp then return end
	local k = keyMap[i.KeyCode]
	if k then keys[k] = true end
	local a = actKey[i.KeyCode]
	if a and uiReady and actions[a] then actions[a]() end
end)
bind(UIS.InputEnded, function(i)
	local k = keyMap[i.KeyCode]
	if k then keys[k] = false end
end)
bind(UIS.WindowFocusReleased, function()
	for k in pairs(inp) do inp[k] = false end
	for k in pairs(keys) do keys[k] = false end
end)

