bind(UIS.InputChanged, function(i, gp)
	if state ~= "driving" then return end
	if i.UserInputType == Enum.UserInputType.MouseMovement then
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			camYaw = camYaw + i.Delta.X * 0.005
			camPitch = math.clamp(camPitch + i.Delta.Y * 0.004, -1.0, 0.8)
			lastDrag = tick()
		end
	elseif i.UserInputType == Enum.UserInputType.Touch then
		if not gp then
			camYaw = camYaw + i.Delta.X * 0.006
			camPitch = math.clamp(camPitch + i.Delta.Y * 0.005, -1.0, 0.8)
			lastDrag = tick()
		end
	elseif i.UserInputType == Enum.UserInputType.MouseWheel then
		camDist = math.clamp(camDist - i.Position.Z * 3, 16, 70)
	end
end)

