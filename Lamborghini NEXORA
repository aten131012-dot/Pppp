local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function styleBtn(b, accent, bar)
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.BackgroundColor3 = INK
	b.BackgroundTransparency = 0.15
	b.TextColor3 = WHITE
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Color = accent
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	if bar then
		local f = Instance.new("Frame")
		f.Size = UDim2.new(0, 4, 0.56, 0)
		f.Position = UDim2.new(0, 8, 0.22, 0)
		f.BackgroundColor3 = accent
		f.BorderSizePixel = 0
		f.Parent = b
		Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
	end
	local dark = accent:Lerp(Color3.new(0, 0, 0), 0.55)
	b.InputBegan:Connect(function(i)
		if isPress(i) then
			TS:Create(b, TweenInfo.new(0.08), {BackgroundColor3 = dark, BackgroundTransparency = 0.03}):Play()
			TS:Create(stroke, TweenInfo.new(0.08), {Thickness = 3.4}):Play()
		end
	end)
	b.InputEnded:Connect(function(i)
		if isPress(i) then
			TS:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = INK, BackgroundTransparency = 0.15}):Play()
			TS:Create(stroke, TweenInfo.new(0.15), {Thickness = 2}):Play()
		end
	end)
end

-- ปุ่มที่เปลี่ยนข้อความตามโหมด (คอม = โชว์ตัวอักษรคีย์)
local labelled = {}
local function setLabel(b, d)
	if env.NEXORA_MODE == "pc" and d.key then
		b.Text = d.stack and (d.text .. "\n" .. d.key) or (d.text .. " [" .. d.key .. "]")
	else
		b.Text = d.text
	end
end
local function refreshLabels()
	for b, d in pairs(labelled) do setLabel(b, d) end
end
local function setBtnText(b, t)
	if labelled[b] then
		labelled[b].text = t
		setLabel(b, labelled[b])
	end
end

local function makeBtn(o)
	local b = Instance.new("TextButton")
	b.Name = o.name
	b.Size = o.size
	b.Position = o.pos or UDim2.new()
	b.AnchorPoint = o.anchor or Vector2.new(0, 0)
	b.Font = o.font or Enum.Font.GothamBlack
	b.TextScaled = true
	b.LayoutOrder = o.order or 0
	b.Parent = o.parent or gui
	local cons = Instance.new("UITextSizeConstraint")
	cons.MaxTextSize = o.ts or 20
	cons.MinTextSize = 8
	cons.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, o.bar and 16 or 3)
	pad.PaddingRight = UDim.new(0, 3)
	pad.PaddingTop = UDim.new(0, 3)
	pad.PaddingBottom = UDim.new(0, 3)
	pad.Parent = b
	styleBtn(b, o.accent, o.bar)
	labelled[b] = {text = o.text, key = o.key, stack = o.stack}
	setLabel(b, labelled[b])
	return b
end

